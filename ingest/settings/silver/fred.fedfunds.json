{
    "function_path": "lakehouse.silver.ingest.from_table.upsert.without_delete",
    "environments": ["free"],
    "source_table": "${catalog_prefix}fred.bronze.fedfunds",
    "destination_table": "${catalog_prefix}fred.silver.fedfunds",
    "readStream_options": {
        "ignoreChanges": "true"
    },
    "writeStream_options": {
        "checkpointLocation": "/Volumes/${catalog_prefix}utility/silver/state/${catalog_prefix}fred.silver.fedfunds/_checkpoints/"
    },
    "column_map": {},
    "data_type_map": {
        "observation_date": "date",
        "FEDFUNDS": "double"
    },
    "pk": {
        "name": "primary_key",
        "columns": ["observation_date"]
    },
    "on_duplicate_pk": "raise"
}
