{
    "function_path": "lakehouse.silver.ingest.from_table.upsert.without_delete",
    "environments": ["free"],
    "source_table": "${catalog_prefix}fdic.bronze.financials",
    "destination_table": "${catalog_prefix}fdic.silver.financials",
    "readStream_options": {
        "ignoreChanges": "true"
    },
    "writeStream_options": {
        "checkpointLocation": "/Volumes/${catalog_prefix}utility/silver/state/${catalog_prefix}fdic.silver.financials/_checkpoints/"
    },
    "column_map": {},
    "data_type_map": {
        "REPDTE": "date",
        "ASSET": "double",
        "DEP": "double",
        "NETINC": "double",
        "EQ": "double",
        "ROA": "double"
    },
    "pk": {
        "name": "primary_key",
        "columns": ["CERT", "REPDTE"]
    },
    "on_duplicate_pk": "raise"
}
