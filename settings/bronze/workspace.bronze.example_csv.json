{
    "function_path": "lakehouse.bronze.ingest.from_files",
    "source_type": "cloudFiles",
    "destination_table": "workspace.bronze.example_csv",
    "readStream_path": "/Volumes/workspace/bronze/landing/",
    "readStream_options": {
        "header": true,
        "quote": "\"",
        "escape": "\"",
        "delimiter": ",",
        "pathGlobFilter": "*.csv",
        "encoding": "UTF-8",
        "cloudFiles.format": "csv",
        "cloudFiles.inferColumnTypes": "false",
        "cloudFiles.inferSchema": "false",
        "cloudFiles.schemaLocation": "/Volumes/workspace/bronze/utility/_schema/",
        "cloudFiles.schemaEvolutionMode": "none",
        "cloudFiles.useNotifications": "false",
        "cloudFiles.useIncrementalListing": "auto",
        "cloudFiles.validateOptions": "true",
        "badRecordsPath": "/Volumes/workspace/bronze/utility/_badRecords/",
        "multiLine": "true",
        "ignoreLeadingWhiteSpace": "false",
        "ignoreTrailingWhiteSpace": "false",
        "treatEmptyValuesAsNulls": "true"
    },
    "writeStream_format": "delta",
    "writeStream_options": {
        "mergeSchema": "true",
        "checkpointLocation": "/Volumes/workspace/bronze/utility/_checkpoints/",
        "delta.columnMapping.mode": "name"
    },
    "writeStream_outputMode": "append",
    "trigger_type": { "availableNow": true }
}
